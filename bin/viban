#!/bin/zsh
# viban - Vibe Kanban TUI (Notion-style)
# Requires: gum (brew install gum), jq
setopt EXTENDED_GLOB

# Store script directory at startup (before any function changes $0)
# Resolve symlinks so npm global installs (bin/viban -> ../lib/node_modules/.../bin/viban) work
VIBAN_SCRIPT_DIR="$(cd "$(dirname "${0:A}")/.." && pwd)"

# ============================================================
# Dependency Check (Early exit with helpful messages)
# ============================================================
check_dependencies() {
    local missing=0

    if ! command -v jq &>/dev/null; then
        echo "❌ jq not found"
        [[ "$OSTYPE" == "darwin"* ]] && echo "   Install: brew install jq"
        [[ "$OSTYPE" == "linux"* ]] && echo "   Install: apt install jq"
        missing=1
    fi

    if ! command -v gum &>/dev/null; then
        echo "❌ gum not found"
        [[ "$OSTYPE" == "darwin"* ]] && echo "   Install: brew install gum"
        [[ "$OSTYPE" == "linux"* ]] && echo "   Install: See https://github.com/charmbracelet/gum#installation"
        missing=1
    fi

    if [[ $missing -eq 1 ]]; then
        echo ""
        echo "Please install missing dependencies and try again."
        exit 1
    fi
}

# Only check dependencies for interactive commands (not help)
[[ "$1" != "help" && "$1" != "--help" && "$1" != "-h" && "$1" != "sync" ]] && check_dependencies

# ============================================================
# Auto-update Check (once per day, cached)
# ============================================================
_VIBAN_UPDATE_CACHE="${HOME}/.cache/viban/update-check"

auto_update_check() {
    local cache_dir="${HOME}/.cache/viban"
    mkdir -p "$cache_dir"

    local now=$(date +%s)
    local last_check=0
    local cached_latest=""

    # Read cache
    if [[ -f "$_VIBAN_UPDATE_CACHE" ]]; then
        last_check=$(sed -n '1p' "$_VIBAN_UPDATE_CACHE" 2>/dev/null)
        cached_latest=$(sed -n '2p' "$_VIBAN_UPDATE_CACHE" 2>/dev/null)
        [[ -z "$last_check" ]] && last_check=0
    fi

    local current
    current=$(grep '"version"' "$VIBAN_SCRIPT_DIR/package.json" 2>/dev/null | sed 's/.*: *"\([^"]*\)".*/\1/')
    [[ -z "$current" ]] && return

    # Check npm registry at most once per day (86400 seconds)
    local elapsed=$((now - last_check))
    if (( elapsed > 86400 )); then
        # Background check: fetch latest version and write cache
        {
            local latest
            latest=$(npm show claude-plugin-viban version 2>/dev/null)
            if [[ -n "$latest" ]]; then
                printf '%s\n%s\n' "$now" "$latest" > "$_VIBAN_UPDATE_CACHE"
            fi
        } &!
        # Use cached_latest from previous check for this invocation
    fi

    # Compare and auto-update if newer version available
    if [[ -n "$cached_latest" && "$cached_latest" != "$current" ]]; then
        # Simple semver comparison: split on dots and compare numerically
        local -a cv lv
        cv=("${(@s/./)current}")
        lv=("${(@s/./)cached_latest}")
        local is_newer=false c l
        for i in 1 2 3; do
            c=${cv[$i]:-0}; l=${lv[$i]:-0}
            # Strip non-numeric suffixes (e.g. 1-beta -> 1)
            c=${c%%[^0-9]*}; l=${l%%[^0-9]*}
            [[ -z "$c" ]] && c=0; [[ -z "$l" ]] && l=0
            if (( l > c )); then
                is_newer=true
                break
            elif (( l < c )); then
                break
            fi
        done

        if $is_newer; then
            echo "📦 New version available: $current → $cached_latest"
            echo "   Updating..."
            if npm install -g claude-plugin-viban@"$cached_latest" 2>/dev/null; then
                echo "   ✓ Updated to $cached_latest"
                # Clear cache so next check is fresh
                rm -f "$_VIBAN_UPDATE_CACHE"
                # Re-exec with the new version
                exec "$0" "$@"
            else
                echo "   ✗ Update failed, continuing with $current"
            fi
        fi
    fi
}

# Run auto-update for all commands except help/version/update itself
case "$1" in
    help|--help|-h|--version|-v|update|sync) ;;
    *) auto_update_check "$@" ;;
esac

IN_TUI=false
cleanup() {
    # Skip cleanup in subshells — EXIT trap fires in $() command substitutions
    [[ ${ZSH_SUBSHELL:-0} -gt 0 ]] && return
    # Kill background sync if running
    [[ -n "${_sync_pid:-}" ]] && kill "$_sync_pid" 2>/dev/null && wait "$_sync_pid" 2>/dev/null
    # Release file lock if held
    ${_VIBAN_LOCK_HELD:-false} && rm -rf "${VIBAN_DATA_DIR}/.lock"
    _stop_coproc
    if $IN_TUI; then
        printf '\033[?25h\033[0m'
        stty echo 2>/dev/null
        clear
    fi
    exit 0
}
trap cleanup INT TERM EXIT

# Prevent gum from querying terminal colors
export CLICOLOR_FORCE=1
export COLORTERM=truecolor
export TERM=${TERM:-xterm-256color}

# ============================================================
# Data Path Detection (with edge case handling)
# ============================================================
# Priority:
# 1. VIBAN_DATA_DIR env var (explicit override)
# 2. Project root .viban/ directory

VIBAN_DATA_DIR="${VIBAN_DATA_DIR:-}"
VIBAN_IS_GIT_REPO=false
git rev-parse --git-dir &>/dev/null && VIBAN_IS_GIT_REPO=true

if [[ -z "$VIBAN_DATA_DIR" ]]; then
    if $VIBAN_IS_GIT_REPO; then
        VIBAN_DATA_DIR="$(git rev-parse --show-toplevel)/.viban"
    else
        VIBAN_DATA_DIR="${PWD}/.viban"
    fi
fi

VIBAN_JSON="${VIBAN_DATA_DIR}/viban.json"

# Ensure data directory exists
mkdir -p "$VIBAN_DATA_DIR"

# Auto-migrate: .git/viban.json -> .viban/ (legacy location)
if _git_common="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    _git_dir="$(cd "$_git_common" && pwd)"
    if [[ -f "${_git_dir}/viban.json" && ! -f "$VIBAN_JSON" ]]; then
        mv "${_git_dir}/viban.json" "$VIBAN_JSON"
        echo "✓ Migrated viban.json from .git/ to .viban/"
    fi
    if [[ -f "${_git_dir}/sync.json" && ! -f "${VIBAN_DATA_DIR}/sync.json" ]]; then
        mv "${_git_dir}/sync.json" "${VIBAN_DATA_DIR}/sync.json"
        echo "✓ Migrated sync.json from .git/ to .viban/"
    fi
fi

# ============================================================
# Initialize viban.json if not exists
# ============================================================
init_viban_json() {
    if [[ ! -f "$VIBAN_JSON" ]]; then
        cat > "$VIBAN_JSON" << 'EOF'
{
  "version": 2,
  "next_id": 1,
  "issues": []
}
EOF
        echo "✨ Initialized new viban board at: $VIBAN_JSON"
    fi
}

# Auto-initialize for commands that need data (not help/init)
case "$1" in
    help|--help|-h|--version|-v|update|init|sync) ;;
    *) init_viban_json ;;
esac

# ============================================================
# Source library modules
# ============================================================
source "$VIBAN_SCRIPT_DIR/lib/config.zsh"
source "$VIBAN_SCRIPT_DIR/lib/helpers.zsh"
source "$VIBAN_SCRIPT_DIR/lib/tui.zsh"
source "$VIBAN_SCRIPT_DIR/lib/commands.zsh"

# ============================================================
# Main dispatch
# ============================================================
main() {
    check_deps
    init_json
    # Auto-archive old done issues (skip when user explicitly runs archive)
    [[ "${1:-}" != "archive" ]] && auto_archive
    case "${1:-}" in
        list)   shift; cmd_list "$@";;
        history) cmd_history;;
        add)    shift; _with_lock cmd_add "$@";;
        attach) shift; _with_lock cmd_attach "$@";;
        assign) shift; _with_lock cmd_assign "$@";;
        review) shift; _with_lock cmd_review "$@";;
        done)   shift; _with_lock cmd_done "$@";;
        move)   shift; _with_lock cmd_move "$@";;
        get)    cmd_get "$2";;
        comment) shift; _with_lock cmd_comment "$@";;
        link)   _with_lock cmd_link "$2" "$3" "$4";;
        unlink) shift; _with_lock cmd_unlink "$@";;
        edit)   [[ -z "$2" ]] && { echo "Usage: viban edit <id>"; exit 1; }; _with_lock edit_issue "$2";;
        priority) _with_lock cmd_priority "$2" "$3";;
        stats)   cmd_stats;;
        backup)  _with_lock cmd_backup;;
        restore) shift; _with_lock cmd_restore "$@";;
        changelog) cmd_changelog "$2";;
        export)  cmd_export "$2";;
        migrate) _with_lock cmd_migrate;;
        archive) shift; _with_lock cmd_archive "$@";;
        sync)   shift; cmd_sync "$@";;
        --version|-v)
            # Get version from package.json
            if [[ -f "$VIBAN_SCRIPT_DIR/package.json" ]]; then
                grep '"version"' "$VIBAN_SCRIPT_DIR/package.json" | sed 's/.*: *"\([^"]*\)".*/\1/'
            else
                echo "unknown"
            fi
            ;;
        update)
            # Silent update check - only updates if newer version available
            local current latest
            current=$(grep '"version"' "$VIBAN_SCRIPT_DIR/package.json" 2>/dev/null | sed 's/.*: *"\([^"]*\)".*/\1/')
            latest=$(npm show claude-plugin-viban version 2>/dev/null)
            [[ -z "$current" || -z "$latest" || "$current" == "$latest" ]] && exit 0
            echo "📦 Updating viban: $current → $latest"
            npm update -g claude-plugin-viban && echo "✓ Updated to $latest"
            ;;
        help|--help|-h)
            echo "viban - Vibe Kanban"
            echo ""
            echo "  viban             TUI"
            echo "  viban list        Show board"
            echo "  viban list [--status <s>] [--priority P0,P1] [--type bug] [--search text]"
            echo "  viban history     Show completed issues"
            echo "  viban add \"title\" [\"desc\"] [P0-P3] [type] [--parent <id>]  Add task"
            echo "  viban attach <id> <file1> [file2...]  Attach files to task"
            echo "  viban priority <id> <P0-P3>   Set priority"
            echo "  viban assign      Assign first backlog (by priority)"
            echo "  viban review      → Human Review"
            echo "  viban move <id> <status>     Move to status (backlog,in_progress,review,done)"
            echo "  viban done <id> [--purge] [--force]  Complete (requires review status; --force to bypass)"
            echo "  viban comment <id> \"msg\"  Add comment to task"
            echo "  viban link <id> blocks <id>  Add dependency"
            echo "  viban unlink <id> blocks <id>  Remove dependency"
            echo "  viban edit <id>   Edit task in editor"
            echo "  viban get <id>    Get task details (JSON)"
            echo "  viban stats       Show throughput metrics and statistics"
            echo "  viban backup      Snapshot viban.json to backups/"
            echo "  viban restore [f] List or restore a backup"
            echo "  viban changelog [range]  Generate changelog from commits"
            echo "  viban export [md|html]   Export board as markdown or HTML"
            echo "  viban archive [--days N]  Archive done issues older than N days (default 30)"
            echo "  viban migrate     Migrate: extract type from title"
            echo "  viban sync        Sync with external issue tracker (GitHub, etc.)"
            echo "  viban update      Update to latest version (if available)"
            echo ""
            echo "  Priority: P0=CRITICAL, P1=HIGH, P2=MEDIUM, P3=LOW"
            echo "  Type: bug, feat, chore, refactor"
            ;;
        "") level1_columns;;
        *) echo "Unknown: $1"; exit 1;;
    esac
}

main "$@"
